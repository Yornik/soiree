{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch updates",
      "automerge": true
    },
    {
      "description": "Actions are pinned to commit digests (helpers:pinGitHubActionDigests). Renovate bumps the digest and rewrites the trailing '# vX.Y.Z' comment, so pinning stays maintainable rather than rotting.",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Keep GO_VERSION in the workflows in step with the Dockerfile, so CI tests the same toolchain the image ships.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "GO_VERSION:\\s*'(?<currentValue>.*?)'"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix"
}
