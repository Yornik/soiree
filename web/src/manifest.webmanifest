{
  "name": {{ json .EventName }},
  "short_name": "soiree",
  "description": "Shared budget and task planner for a group event.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F3F1F7",
  "theme_color": "#231B3A",
  "icons": [
    {
      "src": {{ json (.Asset "favicon.svg") }},
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": {{ json (.Asset "icon-192.png") }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ json (.Asset "icon-512.png") }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ json (.Asset "icon-maskable-512.png") }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
